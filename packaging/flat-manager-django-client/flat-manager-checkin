#!/usr/bin/env python3
''':'
exec python3 "$0" "$@"
'''
# flat-manager-checkin — check-in agent for flat-manager-django
#
# Collects system-wide and per-user flatpak state and reports it to the
# flat-manager server so the Clients dashboard can track managed machines.
#
# Per-user collection requires root (uses runuser).  If run as a non-root
# user, only system-wide data is collected and a warning is printed.
#
# Config: /etc/flat-manager-django-client/config
# Usage:  flat-manager-checkin [--server URL] [--hostname NAME]

import argparse
import configparser
import datetime
import grp
import json
import os
import pwd
import shutil
import socket
import subprocess
import sys
import urllib.request
import urllib.error


CONFIG_PATH = '/etc/flat-manager-django-client/config'
STATE_DIR = '/etc/flat-manager-django-client'
LOCKDOWN_STATE_PATH = os.path.join(STATE_DIR, 'lockdown-state.json')
IGNORED_USERNAMES = {'nobody'}


def read_config():
    cfg = configparser.ConfigParser()
    cfg.read(CONFIG_PATH)
    return cfg


def run(cmd):
    """Run a command, return stdout as a string (stderr suppressed)."""
    result = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    return result.stdout.strip()


def command_exists(name):
    return shutil.which(name) is not None


def run_checked(cmd, input_text=None):
    result = subprocess.run(
        cmd,
        input=input_text,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)} failed: {result.stderr.strip() or result.stdout.strip()}")
    return result.stdout


def ensure_state_dir():
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)


def write_file(path, content, mode=0o600):
    with open(path, 'w', encoding='utf-8') as handle:
        handle.write(content)
    os.chmod(path, mode)


def list_backup_files():
    try:
        return sorted(
            name for name in os.listdir(STATE_DIR)
            if name != os.path.basename(LOCKDOWN_STATE_PATH)
        )
    except OSError:
        return []


def print_lockdown_result(result):
    print(f"Firewall backend: {result.get('backend', 'unknown')}")
    print(f"State file: {LOCKDOWN_STATE_PATH}")
    if result.get('already_locked'):
        print('Status: already locked down; no firewall changes were applied')
    else:
        print('Status: lockdown applied')
    backups = result.get('backups') or []
    if backups:
        print('Backup files:')
        for backup in backups:
            print(f'  - {os.path.join(STATE_DIR, backup)}')
    else:
        print('Backup files: none recorded')
    for action in result.get('actions', []):
        print(f'Action: {action}')


def print_unlock_result(result):
    print(f"Firewall backend: {result.get('backend', 'unknown')}")
    print(f"State file removed: {LOCKDOWN_STATE_PATH}")
    for action in result.get('actions', []):
        print(f'Action: {action}')


def print_lock_status():
    print('Network lockdown status')
    print(f'State directory: {STATE_DIR}')
    print(f'State file: {LOCKDOWN_STATE_PATH}')
    detected = detect_firewall_backends()
    selected = detect_firewall_backend()
    print('Firewall detection priority: firewalld, ufw, nftables, iptables')
    print('Detected firewalls: ' + (', '.join(detected) if detected else 'none'))
    print(f"Selected backend if locking now: {selected or 'none'}")
    firewalld = firewalld_status()
    if firewalld['installed']:
        print('Firewalld config:')
        print(f"  active: {firewalld['active'] if firewalld['active'] is not None else 'unknown'}")
        print(f"  enabled: {firewalld['enabled'] if firewalld['enabled'] is not None else 'unknown'}")
    if 'ufw' in detected:
        ufw_status = ufw_config_status()
        print('UFW config:')
        print(f"  enabled: {ufw_status['enabled_raw']}")
        print(f"  default input: {ufw_status['default_input_policy']}")
        print(f"  default output: {ufw_status['default_output_policy']}")
        print(f"  default forward: {ufw_status['default_forward_policy']}")

    try:
        state = read_lockdown_state()
    except PermissionError:
        print('Saved lockdown state: unreadable; run as root to inspect it')
        return
    except json.JSONDecodeError as exc:
        print(f'Saved lockdown state: invalid JSON ({exc})')
        return

    if not state:
        print('Saved lockdown state: not locked by flat-manager-checkin')
        return

    print('Saved lockdown state: locked')
    print(f"Saved backend: {state.get('backend', 'unknown')}")
    print(f"Saved at: {state.get('created_at', 'unknown')}")
    backups = list_backup_files()
    if backups:
        print('Backup files:')
        for backup in backups:
            print(f'  - {os.path.join(STATE_DIR, backup)}')
    else:
        print('Backup files: none found')


def read_lockdown_state():
    try:
        with open(LOCKDOWN_STATE_PATH, 'r', encoding='utf-8') as handle:
            return json.load(handle)
    except FileNotFoundError:
        return None


def write_lockdown_state(backend, metadata=None):
    ensure_state_dir()
    state = {
        'backend': backend,
        'created_at': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    }
    if metadata:
        state.update(metadata)
    write_file(LOCKDOWN_STATE_PATH, json.dumps(state, indent=2) + '\n')


def read_key_value_file(path):
    values = {}
    try:
        with open(path, 'r', encoding='utf-8', errors='replace') as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith('#') or '=' not in line:
                    continue
                key, value = line.split('=', 1)
                values[key.strip()] = value.strip().strip('"')
    except OSError:
        pass
    return values


def ufw_config_status():
    ufw_conf = read_key_value_file('/etc/ufw/ufw.conf')
    default_ufw = read_key_value_file('/etc/default/ufw')
    return {
        'enabled': ufw_conf.get('ENABLED', '').lower() == 'yes',
        'enabled_raw': ufw_conf.get('ENABLED', 'unknown'),
        'default_input_policy': default_ufw.get('DEFAULT_INPUT_POLICY', 'unknown'),
        'default_output_policy': default_ufw.get('DEFAULT_OUTPUT_POLICY', 'unknown'),
        'default_forward_policy': default_ufw.get('DEFAULT_FORWARD_POLICY', 'unknown'),
    }


def systemctl_is_active(unit):
    if not command_exists('systemctl'):
        return None
    result = subprocess.run(['systemctl', 'is-active', '--quiet', unit])
    return result.returncode == 0


def systemctl_is_enabled(unit):
    if not command_exists('systemctl'):
        return None
    result = subprocess.run(['systemctl', 'is-enabled', '--quiet', unit])
    return result.returncode == 0


def firewalld_status():
    return {
        'installed': command_exists('firewall-cmd'),
        'active': systemctl_is_active('firewalld'),
        'enabled': systemctl_is_enabled('firewalld'),
    }


def detect_firewall_backend():
    if command_exists('firewall-cmd'):
        state = subprocess.run(['firewall-cmd', '--state'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if state.returncode == 0:
            return 'firewalld'
    if command_exists('ufw'):
        return 'ufw'
    if command_exists('nft'):
        return 'nftables'
    if command_exists('iptables'):
        return 'iptables'
    return None


def detect_firewall_backends():
    detected = []
    if command_exists('firewall-cmd'):
        state = subprocess.run(['firewall-cmd', '--state'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if state.returncode == 0:
            detected.append('firewalld')
        else:
            detected.append('firewalld-installed-inactive')
    if command_exists('ufw'):
        detected.append('ufw')
    if command_exists('nft'):
        detected.append('nftables')
    if command_exists('iptables'):
        detected.append('iptables')
    return detected


def backup_firewalld():
    status = firewalld_status()
    if os.path.isdir('/etc/firewalld'):
        dest = os.path.join(STATE_DIR, 'firewalld')
        if os.path.exists(dest):
            shutil.rmtree(dest)
        shutil.copytree('/etc/firewalld', dest, symlinks=True)
    write_file(os.path.join(STATE_DIR, 'firewalld-zones.txt'), run_checked(['firewall-cmd', '--list-all-zones']))
    return {
        'firewalld_active_before_lockdown': status['active'],
        'firewalld_enabled_before_lockdown': status['enabled'],
    }


def backup_ufw():
    status = ufw_config_status()
    if os.path.isdir('/etc/ufw'):
        dest = os.path.join(STATE_DIR, 'ufw')
        if os.path.exists(dest):
            shutil.rmtree(dest)
        shutil.copytree('/etc/ufw', dest, symlinks=True)
    if os.path.exists('/etc/default/ufw'):
        shutil.copy2('/etc/default/ufw', os.path.join(STATE_DIR, 'default-ufw'))
    write_file(os.path.join(STATE_DIR, 'ufw-status.txt'), run(['ufw', 'status', 'verbose']) + '\n')
    return {'ufw_enabled_before_lockdown': status['enabled']}


def backup_nftables():
    write_file(os.path.join(STATE_DIR, 'nftables.rules'), run_checked(['nft', 'list', 'ruleset']))
    if os.path.exists('/etc/nftables.conf'):
        shutil.copy2('/etc/nftables.conf', os.path.join(STATE_DIR, 'nftables.conf'))
    if command_exists('iptables-save'):
        write_file(os.path.join(STATE_DIR, 'nftables-iptables.rules'), run_checked(['iptables-save']))
    if command_exists('ip6tables-save'):
        write_file(os.path.join(STATE_DIR, 'nftables-ip6tables.rules'), run_checked(['ip6tables-save']))


def backup_iptables():
    write_file(os.path.join(STATE_DIR, 'iptables.rules'), run_checked(['iptables-save']))
    if command_exists('ip6tables-save'):
        write_file(os.path.join(STATE_DIR, 'ip6tables.rules'), run_checked(['ip6tables-save']))


def backup_firewall(backend):
    ensure_state_dir()
    metadata = {}
    if backend == 'firewalld':
        metadata.update(backup_firewalld())
    elif backend == 'ufw':
        metadata.update(backup_ufw())
    elif backend == 'nftables':
        backup_nftables()
    elif backend == 'iptables':
        backup_iptables()
    else:
        raise RuntimeError('No supported firewall backend found')
    write_lockdown_state(backend, metadata=metadata)


def apply_firewalld_lockdown():
    run_checked(['firewall-cmd', '--panic-on'])
    for family in ('ipv4', 'ipv6'):
        for chain in ('INPUT', 'OUTPUT', 'FORWARD'):
            subprocess.run(['firewall-cmd', '--permanent', '--direct', '--remove-rules', family, 'filter', chain], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            run_checked(['firewall-cmd', '--permanent', '--direct', '--add-rule', family, 'filter', chain, '0', '-j', 'DROP'])
    run_checked(['firewall-cmd', '--reload'])
    run_checked(['firewall-cmd', '--panic-on'])


def apply_ufw_lockdown():
    run_checked(['ufw', '--force', 'reset'])
    run_checked(['ufw', 'default', 'deny', 'incoming'])
    run_checked(['ufw', 'default', 'deny', 'outgoing'])
    run_checked(['ufw', 'default', 'deny', 'routed'])
    run_checked(['ufw', '--force', 'enable'])


def apply_nftables_lockdown():
    rules = '''flush ruleset
table inet flat_manager_lockdown {
    chain input {
        type filter hook input priority 0; policy drop;
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    chain output {
        type filter hook output priority 0; policy drop;
    }
}
'''
    run_checked(['nft', '-f', '-'], input_text=rules)
    write_file('/etc/nftables.conf', rules, mode=0o644)


def restore_nftables_compat_backup(result):
    ipv4_rules_path = os.path.join(STATE_DIR, 'nftables-iptables.rules')
    ipv6_rules_path = os.path.join(STATE_DIR, 'nftables-ip6tables.rules')
    if os.path.exists(ipv4_rules_path):
        restore_cmd = 'iptables-nft-restore' if command_exists('iptables-nft-restore') else 'iptables-restore'
        if not command_exists(restore_cmd):
            raise RuntimeError('Missing iptables restore tool for nftables compatibility backup')
        with open(ipv4_rules_path, 'r', encoding='utf-8') as handle:
            run_checked([restore_cmd], input_text=handle.read())
        result['actions'].append(f'restored nftables-compatible IPv4 rules using {restore_cmd}')
    if os.path.exists(ipv6_rules_path):
        restore_cmd = 'ip6tables-nft-restore' if command_exists('ip6tables-nft-restore') else 'ip6tables-restore'
        if command_exists(restore_cmd):
            with open(ipv6_rules_path, 'r', encoding='utf-8') as handle:
                run_checked([restore_cmd], input_text=handle.read())
            result['actions'].append(f'restored nftables-compatible IPv6 rules using {restore_cmd}')


def restore_nftables_backup(result):
    rules_path = os.path.join(STATE_DIR, 'nftables.rules')
    if not os.path.exists(rules_path):
        raise RuntimeError('Missing nftables backup')
    conf_backup = os.path.join(STATE_DIR, 'nftables.conf')
    run_checked(['nft', 'flush', 'ruleset'])
    try:
        run_checked(['nft', '-f', rules_path])
        result['actions'].append('restored saved nftables ruleset')
    except RuntimeError as exc:
        restored = False
        if os.path.exists(conf_backup):
            try:
                run_checked(['nft', '-f', conf_backup])
                result['actions'].append(f'nft ruleset restore failed; restored saved {conf_backup} instead: {exc}')
                restored = True
            except RuntimeError:
                restore_nftables_compat_backup(result)
        else:
            restore_nftables_compat_backup(result)
        if not restored and not os.path.exists(os.path.join(STATE_DIR, 'nftables-iptables.rules')) and not os.path.exists(conf_backup):
            result['actions'].append(
                'nft ruleset restore failed and no compatibility backup existed; left ruleset flushed to remove lockdown rules'
            )
        elif not restored:
            result['actions'].append(f'nft ruleset restore failed; compatibility restore was used instead: {exc}')
    if os.path.exists(conf_backup):
        shutil.copy2(conf_backup, '/etc/nftables.conf')
    else:
        write_file('/etc/nftables.conf', 'flush ruleset\n', mode=0o644)


def apply_iptables_lockdown():
    commands = [
        ['iptables', '-F'], ['iptables', '-X'], ['iptables', '-t', 'nat', '-F'], ['iptables', '-t', 'mangle', '-F'],
        ['iptables', '-P', 'INPUT', 'DROP'], ['iptables', '-P', 'OUTPUT', 'DROP'], ['iptables', '-P', 'FORWARD', 'DROP'],
    ]
    if command_exists('ip6tables'):
        commands += [
            ['ip6tables', '-F'], ['ip6tables', '-X'], ['ip6tables', '-t', 'nat', '-F'], ['ip6tables', '-t', 'mangle', '-F'],
            ['ip6tables', '-P', 'INPUT', 'DROP'], ['ip6tables', '-P', 'OUTPUT', 'DROP'], ['ip6tables', '-P', 'FORWARD', 'DROP'],
        ]
    for cmd in commands:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    ipv4_rules = run_checked(['iptables-save'])
    write_file(os.path.join(STATE_DIR, 'iptables-lockdown.rules'), ipv4_rules)
    if os.path.isdir('/etc/iptables'):
        write_file('/etc/iptables/rules.v4', ipv4_rules, mode=0o644)
    if command_exists('ip6tables-save'):
        ipv6_rules = run_checked(['ip6tables-save'])
        write_file(os.path.join(STATE_DIR, 'ip6tables-lockdown.rules'), ipv6_rules)
        if os.path.isdir('/etc/iptables'):
            write_file('/etc/iptables/rules.v6', ipv6_rules, mode=0o644)


def lockdown_network():
    if os.geteuid() != 0:
        raise RuntimeError('lockdown requires root')
    existing_state = read_lockdown_state()
    if existing_state:
        return {
            'backend': existing_state.get('backend'),
            'already_locked': True,
            'backups': list_backup_files(),
            'actions': ['existing lockdown state found; skipped firewall changes'],
        }
    backend = detect_firewall_backend()
    if not backend:
        raise RuntimeError('No supported firewall backend found')
    backup_firewall(backend)
    result = {
        'backend': backend,
        'already_locked': False,
        'backups': list_backup_files(),
        'actions': [
            'detected firewalls: ' + (', '.join(detect_firewall_backends()) or 'none'),
            f'selected highest-priority backend: {backend}',
            f'backed up current firewall configuration under {STATE_DIR}',
        ],
    }
    try:
        if backend == 'firewalld':
            apply_firewalld_lockdown()
            result['actions'].append('enabled firewalld panic mode and installed permanent DROP direct rules')
        elif backend == 'ufw':
            apply_ufw_lockdown()
            result['actions'].append('reset ufw, set default deny incoming/outgoing/routed, and enabled ufw')
        elif backend == 'nftables':
            apply_nftables_lockdown()
            result['actions'].append('flushed nftables and installed persistent inet drop policies')
        elif backend == 'iptables':
            apply_iptables_lockdown()
            result['actions'].append('flushed iptables/ip6tables and set INPUT/OUTPUT/FORWARD default DROP')
    except Exception:
        try:
            os.remove(LOCKDOWN_STATE_PATH)
        except FileNotFoundError:
            pass
        raise
    return result


def unlock_network():
    if os.geteuid() != 0:
        raise RuntimeError('unlock requires root')
    state = read_lockdown_state()
    if not state:
        raise RuntimeError(f'No lockdown state found at {LOCKDOWN_STATE_PATH}')
    backend = state.get('backend')
    result = {'backend': backend, 'actions': []}
    if backend == 'firewalld':
        backup_dir = os.path.join(STATE_DIR, 'firewalld')
        if os.path.isdir(backup_dir):
            if os.path.exists('/etc/firewalld'):
                shutil.rmtree('/etc/firewalld')
            shutil.copytree(backup_dir, '/etc/firewalld', symlinks=True)
        if command_exists('firewall-cmd'):
            if command_exists('systemctl'):
                subprocess.run(['systemctl', 'start', 'firewalld'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(['firewall-cmd', '--panic-off'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(['firewall-cmd', '--reload'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if command_exists('systemctl'):
            if state.get('firewalld_enabled_before_lockdown') is True:
                subprocess.run(['systemctl', 'enable', 'firewalld'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            elif state.get('firewalld_enabled_before_lockdown') is False:
                subprocess.run(['systemctl', 'disable', 'firewalld'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if state.get('firewalld_active_before_lockdown') is False:
                subprocess.run(['systemctl', 'stop', 'firewalld'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        result['actions'].append('restored /etc/firewalld backup, disabled panic mode, and restored prior firewalld active/enabled state')
    elif backend == 'ufw':
        backup_dir = os.path.join(STATE_DIR, 'ufw')
        if not os.path.isdir(backup_dir):
            raise RuntimeError('Missing ufw backup directory')
        if os.path.exists('/etc/ufw'):
            shutil.rmtree('/etc/ufw')
        shutil.copytree(backup_dir, '/etc/ufw', symlinks=True)
        default_backup = os.path.join(STATE_DIR, 'default-ufw')
        if os.path.exists(default_backup):
            shutil.copy2(default_backup, '/etc/default/ufw')
        if state.get('ufw_enabled_before_lockdown'):
            subprocess.run(['ufw', '--force', 'reload'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            result['actions'].append('restored /etc/ufw and /etc/default/ufw backups and reloaded ufw')
        else:
            subprocess.run(['ufw', '--force', 'disable'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            result['actions'].append('restored /etc/ufw and /etc/default/ufw backups and disabled ufw because it was disabled before lockdown')
    elif backend == 'nftables':
        restore_nftables_backup(result)
    elif backend == 'iptables':
        rules_path = os.path.join(STATE_DIR, 'iptables.rules')
        if not os.path.exists(rules_path):
            raise RuntimeError('Missing iptables backup')
        with open(rules_path, 'r', encoding='utf-8') as handle:
            run_checked(['iptables-restore'], input_text=handle.read())
        ip6_rules_path = os.path.join(STATE_DIR, 'ip6tables.rules')
        if os.path.exists(ip6_rules_path) and command_exists('ip6tables-restore'):
            with open(ip6_rules_path, 'r', encoding='utf-8') as handle:
                run_checked(['ip6tables-restore'], input_text=handle.read())
        result['actions'].append('restored saved iptables/ip6tables rules')
    else:
        raise RuntimeError(f'Unsupported saved firewall backend: {backend}')
    os.remove(LOCKDOWN_STATE_PATH)
    return result


def run_as_user(username, cmd):
    """Run a command as *username* via runuser. Returns stdout or '' on failure."""
    result = subprocess.run(
        ['runuser', '-u', username, '--'] + cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    return result.stdout.strip()


def get_remotes():
    """Return list of {name, url} dicts for all system flatpak remotes."""
    out = run(['flatpak', 'remotes', '--system', '--columns=name,url'])
    remotes = []
    for line in out.splitlines():
        parts = line.split('\t', 1)
        if len(parts) == 2:
            remotes.append({'name': parts[0].strip(), 'url': parts[1].strip()})
    return remotes


def get_user_remotes(username):
    """Return list of {name, url} dicts for user-level flatpak remotes of *username*."""
    out = run_as_user(username, ['flatpak', 'remotes', '--user', '--columns=name,url'])
    remotes = []
    for line in out.splitlines():
        parts = line.split('\t', 1)
        if len(parts) == 2:
            remotes.append({'name': parts[0].strip(), 'url': parts[1].strip()})
    return remotes


def get_all_remotes(users=None):
    """
    Return combined list of system remotes plus any user remotes not already
    present (by name) in the system list.  User remotes are collected via
    runuser so root is required; without root only system remotes are returned.
    """
    remotes = get_remotes()
    if os.geteuid() == 0:
        if users is None:
            users = get_local_users()
        seen = {r['name'] for r in remotes}
        for username, _ in users:
            for r in get_user_remotes(username):
                if r['name'] not in seen:
                    remotes.append(r)
                    seen.add(r['name'])
    return remotes


def parse_installed(output):
    """Parse tab-separated flatpak list output into [{app_id, version, origin, name, branch, commit}]."""
    result = []
    for line in output.splitlines():
        parts = line.split('\t')
        if len(parts) >= 3:
            result.append({
                'app_id':  parts[0].strip(),
                'version': parts[1].strip(),
                'origin':  parts[2].strip(),
                'name':    parts[3].strip() if len(parts) > 3 else '',
                'branch':  parts[4].strip() if len(parts) > 4 else '',
                'commit':  parts[5].strip() if len(parts) > 5 else '',
            })
    return result


def refresh_appstream(users=None):
    """
    Refresh appstream metadata so version info is current before collecting data.
    Runs ``flatpak update --appstream`` for the system installation and for
    every human user account (requires root for per-user refresh).
    Failures are non-fatal — the checkin continues with whatever data is
    already cached.
    """
    # System-wide appstream refresh
    result = subprocess.run(
        ['flatpak', 'update', '--appstream', '--system', '--noninteractive'],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        print(f'WARNING: flatpak update --appstream --system failed: {result.stderr.strip()}',
              file=sys.stderr)

    # Per-user appstream refresh (requires root via runuser)
    if os.geteuid() == 0:
        if users is None:
            users = get_local_users()
        for username, _ in users:
            res = subprocess.run(
                ['runuser', '-u', username, '--',
                 'flatpak', 'update', '--appstream', '--user', '--noninteractive'],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                text=True,
            )
            if res.returncode != 0:
                print(f'WARNING: flatpak update --appstream --user failed for {username}: '
                      f'{res.stderr.strip()}', file=sys.stderr)


def get_system_installed():
    out = run(['flatpak', 'list', '--system', '--columns=application,version,origin,name,branch,active'])
    return parse_installed(out)


def get_local_users(ad_groups=None):
    """
    Return list of (username, home) for human accounts.

    Includes local accounts with UID >= 1000 that have an existing home
    directory.  If *ad_groups* is a non-empty list of group names, members of
    those groups (resolved via NSS/SSSD) whose home directories exist on the
    local filesystem are also included.
    """
    seen = set()
    users = []
    for entry in pwd.getpwall():
        if entry.pw_name in IGNORED_USERNAMES:
            continue
        if entry.pw_uid >= 1000 and os.path.isdir(entry.pw_dir):
            users.append((entry.pw_name, entry.pw_dir))
            seen.add(entry.pw_name)
    if ad_groups:
        for username, home in get_ad_group_users(ad_groups):
            if username not in seen:
                users.append((username, home))
                seen.add(username)
    return users


def get_ad_group_users(group_names):
    """
    Return list of (username, home) for members of the given AD/SSSD groups
    whose home directories exist on the local filesystem.

    Group membership is resolved via NSS (getent), so this works transparently
    with SSSD, winbind, or any other NSS provider.  Members whose accounts
    cannot be resolved or who have no local home directory are silently skipped.
    """
    seen = set()
    users = []
    for group_name in group_names:
        try:
            grp_entry = grp.getgrnam(group_name)
        except KeyError:
            print(f'WARNING: AD group {group_name!r} not found via NSS — skipping.',
                  file=sys.stderr)
            continue
        for username in grp_entry.gr_mem:
            if username in IGNORED_USERNAMES:
                continue
            if username in seen:
                continue
            seen.add(username)
            try:
                pw = pwd.getpwnam(username)
            except KeyError:
                continue  # Account listed in group but not resolvable
            if os.path.isdir(pw.pw_dir):
                users.append((username, pw.pw_dir))
    return users


def collect_user_flatpaks(users=None):
    """
    Collect per-user flatpak data (requires root).
    Returns list of {username, installed} for users that have at least one
    flatpak installed.  Update detection is handled server-side.
    """
    if os.geteuid() != 0:
        print('WARNING: not running as root — per-user flatpak data will not be collected.',
              file=sys.stderr)
        return []

    if users is None:
        users = get_local_users()
    result = []
    for username, _ in users:
        installed = parse_installed(
            run_as_user(username, ['flatpak', 'list', '--user',
                                   '--columns=application,version,origin,name,branch,active'])
        )
        if installed:
            result.append({
                'username': username,
                'installed': installed,
            })
    return result


def identify_managed_remotes(remotes, server_url):
    """Return names of remotes whose URL starts with the server URL."""
    server_url = server_url.rstrip('/')
    return [r['name'] for r in remotes if r['url'].rstrip('/').startswith(server_url)]


FACTS_DIR = '/etc/ansible/facts.d'


def collect_tuxmigrate_facts():
    """
    Read all tuxmigrate_*.fact files from /etc/ansible/facts.d/ and return a
    list of dicts with parsed version/order/playbook/applied_date information.

    Filename format:  tuxmigrate_{major}_{minor}_{patch}_{order}_{desc}.fact
    File contents:    {"applied": true, "playbook": "<name>.yaml"}

    Each entry:
        version        str   e.g. "1.0.44"
        version_major  int
        version_minor  int
        version_patch  int
        order          int   e.g. 1
        playbook       str   from file contents
        applied        bool  from file contents
        applied_date   str   ISO-8601 mtime of the fact file
    """
    import datetime
    facts = []
    try:
        filenames = sorted(os.listdir(FACTS_DIR))
    except OSError:
        return facts

    for fname in filenames:
        if not fname.startswith('tuxmigrate_') or not fname.endswith('.fact'):
            continue
        stem = fname[len('tuxmigrate_'):-len('.fact')]  # e.g. "1_0_5_01_usb_bt_headset"
        parts = stem.split('_')
        if len(parts) < 4:
            continue
        try:
            major = int(parts[0])
            minor = int(parts[1])
            patch = int(parts[2])
            order = int(parts[3])
        except ValueError:
            continue

        fpath = os.path.join(FACTS_DIR, fname)
        # Read file contents for playbook name and applied flag
        playbook = ''
        applied = False
        try:
            with open(fpath, 'r', encoding='utf-8', errors='replace') as fh:
                content = json.load(fh)
            playbook = content.get('playbook', '')
            applied = bool(content.get('applied', False))
        except Exception:
            pass

        # File mtime as applied_date
        try:
            mtime = os.path.getmtime(fpath)
            applied_date = datetime.datetime.fromtimestamp(
                mtime, tz=datetime.timezone.utc
            ).strftime('%Y-%m-%dT%H:%M:%SZ')
        except OSError:
            applied_date = ''

        facts.append({
            'version':       f'{major}.{minor}.{patch}',
            'version_major': major,
            'version_minor': minor,
            'version_patch': patch,
            'order':         order,
            'playbook':      playbook,
            'applied':       applied,
            'applied_date':  applied_date,
        })

    # Sort by version then order (ascending)
    facts.sort(key=lambda f: (f['version_major'], f['version_minor'],
                              f['version_patch'], f['order']))
    return facts


def get_serial_number():
    """Best-effort hardware serial number detection."""
    invalid_values = {
        '',
        'none',
        'unknown',
        'not specified',
        'n/a',
        'na',
        'to be filled by o.e.m.',
        'default string',
        'system serial number',
    }

    def _clean(value):
        value = (value or '').strip()
        return value if value and value.lower() not in invalid_values else ''

    # Preferred source: firmware-reported chassis/system serial.
    # Works reliably on most physical systems and matches dmidecode output.
    try:
        value = _clean(run(['dmidecode', '-s', 'system-serial-number']))
        if value:
            return value
    except Exception:
        pass

    candidates = [
        '/sys/class/dmi/id/product_serial',
        '/sys/class/dmi/id/board_serial',
        '/sys/class/dmi/id/chassis_serial',
    ]

    for path in candidates:
        try:
            with open(path, 'r', encoding='utf-8', errors='ignore') as f:
                value = _clean(f.read())
            if value:
                return value
        except Exception:
            continue

    # Fallback for environments where DMI files are unavailable.
    value = run(['cat', '/etc/machine-id']).strip()
    return value or ''


def get_machine_type():
    """Best-effort hardware machine type/model detection."""
    invalid_values = {
        '',
        'none',
        'unknown',
        'not specified',
        'n/a',
        'na',
        'to be filled by o.e.m.',
        'default string',
    }

    def _clean(value):
        value = (value or '').strip()
        return value if value and value.lower() not in invalid_values else ''

    # Preferred source: firmware-reported product/model name.
    try:
        value = _clean(run(['dmidecode', '-s', 'system-product-name']))
        if value:
            return value
    except Exception:
        pass

    # Fallback to sysfs DMI values.
    for path in ('/sys/class/dmi/id/product_name', '/sys/class/dmi/id/chassis_type'):
        try:
            with open(path, 'r', encoding='utf-8', errors='ignore') as f:
                value = _clean(f.read())
            if value:
                return value
        except Exception:
            continue

    return ''


def _format_firmware_version(version):
    """Convert a firmware version string to a human-readable dotted form.

    Handles hex integers from fwupdmgr (e.g. '0x01040300' → '01.04.03').
    Plain strings (e.g. 'X72 Ver. 01.04.03') are returned unchanged.
    """
    v = version.strip()
    if v.startswith(('0x', '0X')):
        try:
            val = int(v, 16)
            b = [(val >> 24) & 0xFF, (val >> 16) & 0xFF,
                 (val >> 8) & 0xFF, val & 0xFF]
            while b and b[-1] == 0:
                b.pop()
            if b:
                return '.'.join(f'{x:02d}' for x in b)
        except ValueError:
            pass
    return v


def get_bios_version():
    """Best-effort BIOS/firmware version detection.

    Primary:  fwupdmgr get-devices --json  (System Firmware entry).
    Fallback: dmidecode -s bios-version.
    Last:     /sys/class/dmi/id/bios_version.

    Returns a human-readable string such as '01.04.03', or '' if unknown.
    """
    invalid_values = {'', 'not specified', 'n/a', 'na', 'unknown', 'none'}

    # 1. fwupdmgr
    try:
        result = subprocess.run(
            ['fwupdmgr', 'get-devices', '--json', '--no-unreported-check'],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=15,
        )
        if result.returncode == 0 and result.stdout:
            import json as _json
            fwupd_data = _json.loads(result.stdout)
            for device in fwupd_data.get('Devices', []):
                if 'System Firmware' in device.get('Name', ''):
                    ver = device.get('Version', '').strip()
                    if ver and ver.lower() not in invalid_values:
                        return _format_firmware_version(ver)
    except Exception:
        pass

    # 2. dmidecode
    try:
        ver = run(['dmidecode', '-s', 'bios-version']).strip()
        if ver and ver.lower() not in invalid_values:
            return ver
    except Exception:
        pass

    # 3. sysfs
    try:
        with open('/sys/class/dmi/id/bios_version', 'r', encoding='utf-8', errors='ignore') as f:
            ver = f.read().strip()
        if ver and ver.lower() not in invalid_values:
            return ver
    except Exception:
        pass

    return ''


def checkin(server_url, hostname, serial_number, machine_type, bios_version, remotes, managed_remotes, installed, user_flatpaks, tuxmigrate_facts):
    """POST the check-in payload to the server."""
    payload = {
        'hostname':          hostname,
        'serial_number':     serial_number,
        'machine_type':      machine_type,
        'bios_version':      bios_version,
        'server_url':        server_url,
        'remotes':           remotes,
        'managed_remotes':   managed_remotes,
        'installed':         installed,
        'user_flatpaks':     user_flatpaks,
        'tuxmigrate_facts':  tuxmigrate_facts,
    }
    data = json.dumps(payload).encode('utf-8')
    url = server_url.rstrip('/') + '/api/client-checkin/'
    req = urllib.request.Request(
        url,
        data=data,
        headers={'Content-Type': 'application/json'},
        method='POST',
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read().decode('utf-8', errors='replace')
            return resp.status, body
    except urllib.error.HTTPError as e:
        body = e.read().decode('utf-8', errors='replace')
        return e.code, body
    except urllib.error.URLError as e:
        return None, str(e.reason)


def main():
    parser = argparse.ArgumentParser(
        prog='flat-manager-checkin',
        description='Check-in agent for flat-manager-django.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            'Config file: /etc/flat-manager-django-client/config\n\n'
            '  [server]\n'
            '  url = https://flat-manager.example.com\n\n'
            '  [client]\n'
            '  # hostname = my-custom-name\n'
            '  # ad_groups = domain users, flatpak-managed\n'
        ),
    )
    parser.add_argument(
        '--server', '-s', metavar='URL',
        help='flat-manager server URL (overrides config file)',
    )
    parser.add_argument(
        '--hostname', metavar='NAME',
        help='hostname to report (overrides config file and system hostname)',
    )
    parser.add_argument(
        '--lock', action='store_true',
        help='back up the current firewall configuration, apply local network lockdown, and exit',
    )
    parser.add_argument(
        '--lock-status', action='store_true',
        help='print current local lockdown state, detected firewall backend, and backup information, then exit',
    )
    parser.add_argument(
        '--unlock', action='store_true',
        help='restore the firewall configuration backed up before local lockdown and exit',
    )
    args = parser.parse_args()

    selected_lock_commands = [args.lock, args.lock_status, args.unlock]
    if sum(1 for selected in selected_lock_commands if selected) > 1:
        parser.error('--lock, --lock-status, and --unlock cannot be used together')

    if args.lock_status:
        print_lock_status()
        return

    if args.lock:
        try:
            print('Starting local network lockdown test')
            print('Firewall detection priority: firewalld, ufw, nftables, iptables')
            result = lockdown_network()
            print_lockdown_result(result)
            return
        except Exception as exc:
            print(f'Lock failed: {exc}', file=sys.stderr)
            sys.exit(1)

    if args.unlock:
        try:
            print('Starting local network lockdown restore')
            result = unlock_network()
            print_unlock_result(result)
            print('Network lockdown restored from backup')
            return
        except Exception as exc:
            print(f'Unlock failed: {exc}', file=sys.stderr)
            sys.exit(1)

    cfg = read_config()

    server_url = (args.server or cfg.get('server', 'url', fallback='')).strip()
    if not server_url:
        parser.error(
            f'No server URL specified. Use --server URL or set [server] url in {CONFIG_PATH}'
        )

    hostname = (
        args.hostname
        or cfg.get('client', 'hostname', fallback='').strip()
        or socket.gethostname()
    )

    ad_groups_raw = cfg.get('client', 'ad_groups', fallback='').strip()
    ad_groups = [g.strip() for g in ad_groups_raw.split(',') if g.strip()] if ad_groups_raw else []

    # Build the full user list once; shared by remotes, appstream refresh, and
    # per-user flatpak collection so that AD/SSSD users are consistently included.
    users = get_local_users(ad_groups=ad_groups or None)

    remotes         = get_all_remotes(users=users)
    managed_remotes = identify_managed_remotes(remotes, server_url)
    serial_number = get_serial_number()
    machine_type = get_machine_type()
    bios_version = get_bios_version()
    refresh_appstream(users=users)

    # System-wide data
    sys_installed = get_system_installed()
    user_flatpaks = collect_user_flatpaks(users=users)
    tuxmigrate_facts = collect_tuxmigrate_facts()

    # Merge user installs into the main list (deduplicate by app_id so runtimes
    # that appear in both system and user scopes are counted only once).
    # Tag each entry with 'user' so the server knows who has it installed.
    for pkg in sys_installed:
        pkg['user'] = 'system'
    installed = list(sys_installed)
    seen_ids = {pkg['app_id'] for pkg in installed}
    for uf in user_flatpaks:
        for pkg in uf.get('installed', []):
            if pkg['app_id'] not in seen_ids:
                tagged = dict(pkg)
                tagged['user'] = uf['username']
                installed.append(tagged)
                seen_ids.add(pkg['app_id'])

    status, body = checkin(server_url, hostname, serial_number, machine_type, bios_version,
                           remotes, managed_remotes, installed, user_flatpaks, tuxmigrate_facts)

    if status == 200:
        print(f'Check-in successful: {hostname} → {server_url}')
        try:
            response_data = json.loads(body)
        except (TypeError, ValueError, json.JSONDecodeError):
            response_data = {}
        if response_data.get('lockdown') is True:
            try:
                print('Server requested network lockdown')
                result = lockdown_network()
                print_lockdown_result(result)
            except Exception as exc:
                print(f'Network lockdown failed: {exc}', file=sys.stderr)
                sys.exit(1)
    else:
        print(f'Check-in failed (HTTP {status}): {body}', file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
