#!/bin/sh
# Load the production environment
set -a
[ -f /etc/flat-manager/flat-manager.env ] && . /etc/flat-manager/flat-manager.env
set +a

# ── Built-in commands (not delegated to manage.py) ───────────────────────────
case "${1:-}" in
    update)
        # Check GitHub for a newer release and upgrade if available.
        if [ "$(id -u)" -ne 0 ]; then
            echo "ERROR: 'flat-manager-manage update' must be run as root." >&2
            exit 1
        fi
        REPO="MrMEEE/flat-manager-django"
        API="https://api.github.com/repos/${REPO}/releases/latest"
        OS_VER=$(rpm -E '%{?rhel}' 2>/dev/null)
        if [ -z "${OS_VER}" ]; then
            echo "ERROR: could not detect RHEL major version." >&2
            exit 1
        fi
        echo "Checking for updates..."
        RELEASE_JSON=$(curl -sf --max-time 15 "${API}") || {
            echo "ERROR: failed to contact GitHub API (is curl installed and the host online?)." >&2
            exit 1
        }
        LATEST_TAG=$(printf '%s' "${RELEASE_JSON}" | \
            python3 -c "import sys,json; print(json.load(sys.stdin)['tag_name'])" 2>/dev/null)
        # Strip one or more leading 'v' characters (tags were historically 'vv0.x.x')
        LATEST_VER=$(echo "${LATEST_TAG}" | sed 's/^v*//')
        if [ -z "${LATEST_VER}" ]; then
            echo "ERROR: could not parse release tag from GitHub response." >&2
            exit 1
        fi
        INSTALLED_VER=$(rpm -q flat-manager-django \
            --queryformat '%{VERSION}' 2>/dev/null)
        if [ -z "${INSTALLED_VER}" ]; then
            echo "ERROR: flat-manager-django does not appear to be installed via RPM." >&2
            exit 1
        fi
        # Strip any leading 'v' from both sides before comparing so the check
        # is robust regardless of whether the git tag or the RPM version carries
        # the prefix (older script versions printed the raw tag, newer ones strip
        # it — make both paths converge here).
        INSTALLED_VER_CLEAN="${INSTALLED_VER#v}"
        if [ "${LATEST_VER}" = "${INSTALLED_VER_CLEAN}" ]; then
            echo "flat-manager-django is already up to date (${INSTALLED_VER_CLEAN})."
            exit 0
        fi
        echo "  Installed : ${INSTALLED_VER_CLEAN}"
        echo "  Available : ${LATEST_VER}"
        echo ""
        printf "Proceed with update? [y/N] "
        read -r CONFIRM
        case "${CONFIRM}" in
            [yY]|[yY][eE][sS]) ;;
            *)
                echo "Update cancelled."
                exit 0
                ;;
        esac
        URLS=$(printf '%s' "${RELEASE_JSON}" | \
            python3 -c "import sys,json; [print(a['browser_download_url']) for a in json.load(sys.stdin)['assets']]" \
            | grep "\.el${OS_VER}\." | grep '\.rpm$' \
            | grep -E '/flat-manager-django(-python-libs)?-[0-9][^/]*\.rpm$')
        if [ -z "${URLS}" ]; then
            echo "ERROR: no server el${OS_VER} RPM assets found for release ${LATEST_TAG}." >&2
            exit 1
        fi
        echo "Installing update..."
        # shellcheck disable=SC2086
        dnf install -y ${URLS} || {
            echo "ERROR: dnf install failed." >&2
            exit 1
        }
        echo "Update to ${LATEST_VER} complete."
        exit 0
        ;;

    diagnose)
        # Quick health-check for stuck/pending builds.
        VENV=/opt/flat-manager/venv
        APP=/opt/flat-manager/app

        echo "=== flat-manager-django installed version ==="
        rpm -q flat-manager-django --queryformat '%{NAME}  %{VERSION}-%{RELEASE}  (%{ARCH})\n' 2>/dev/null \
            || echo "  (not installed via RPM)"
        echo ""

        echo "=== Systemd service status ==="
        for svc in flat-manager-web flat-manager-celery flat-manager-celery-beat flat-manager-celery-ops; do
            printf "  %-35s " "${svc}:"
            systemctl is-active "${svc}" 2>/dev/null || true
        done
        echo ""

        echo "=== Celery worker ping ==="
        "${VENV}/bin/celery" -A config --workdir="${APP}" inspect ping 2>&1 | head -20
        echo ""

        echo "=== Active tasks ==="
        "${VENV}/bin/celery" -A config --workdir="${APP}" inspect active 2>&1 | head -30
        echo ""

        echo "=== Reserved (queued on worker) ==="
        "${VENV}/bin/celery" -A config --workdir="${APP}" inspect reserved 2>&1 | head -20
        echo ""

        echo "=== Active queues per worker ==="
        "${VENV}/bin/celery" -A config --workdir="${APP}" inspect active_queues 2>&1 | head -30
        echo ""

        echo "=== Pending packages in DB ==="
        "${VENV}/bin/python" "${APP}/manage.py" shell -c "
from apps.flatpak.models import Package, BuildStreamSource
pkgs = Package.objects.filter(status='pending')
bsts = BuildStreamSource.objects.filter(status='pending')
if pkgs.exists():
    print(f'  Packages ({pkgs.count()}):')
    for p in pkgs:
        git = (p.git_repo_url or '')[:60] or 'NO GIT URL'
        print(f'    [{p.pk}] #{p.build_number}  {p.package_name}  git={git}')
else:
    print('  No pending packages.')
if bsts.exists():
    print(f'  BST sources ({bsts.count()}):')
    for s in bsts:
        print(f'    [{s.pk}] #{s.build_number}  {s.name}')
else:
    print('  No pending BST sources.')
" 2>&1
        echo ""

        echo "=== check_pending_builds periodic task ==="
        "${VENV}/bin/python" "${APP}/manage.py" shell -c "
from django_celery_beat.models import PeriodicTask
t = PeriodicTask.objects.filter(task__icontains='check_pending').first()
if t:
    print(f'  name    : {t.name}')
    print(f'  enabled : {t.enabled}')
    print(f'  last run: {t.last_run_at}')
else:
    print('  (task not found in django-celery-beat)')
" 2>&1
        echo ""

        echo "=== Recent worker logs (last 30 lines) ==="
        journalctl -u flat-manager-celery -n 30 --no-pager 2>/dev/null \
            || tail -30 /var/log/flat-manager/celery.log 2>/dev/null \
            || echo "  (no logs found)"
        exit 0
        ;;
esac

# ── Delegate everything else to Django manage.py ─────────────────────────────
# When invoked as root (e.g. during initial setup: migrate, createsuperuser)
# drop privileges to the flat-manager service account so that any files created
# (logs, .pyc caches, etc.) are owned by flat-manager, not root.
if [ "$(id -u)" -eq 0 ]; then
    exec runuser -u flat-manager -- \
        /opt/flat-manager/venv/bin/python /opt/flat-manager/app/manage.py "$@"
fi

exec /opt/flat-manager/venv/bin/python /opt/flat-manager/app/manage.py "$@"
