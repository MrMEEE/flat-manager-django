# /etc/flat-manager/flat-manager.env
# Copy this file to flat-manager.env and edit before starting services.
# Owned root:flat-manager, mode 0640 — keep SECRET_KEY and DB_PASSWORD private.

# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-generate-with-python3-c-import-secrets-print-secrets.token_hex-50
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your.server.hostname
TIME_ZONE=Europe/Copenhagen

# ── Database (MariaDB) ────────────────────────────────────────────────────────
DB_ENGINE=mysql
DB_NAME=flatmanager
DB_USER=flatmanager
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=3306

# ── Redis / Valkey ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

# ── Paths (must match the RPM-installed layout) ───────────────────────────────
REPOS_BASE_PATH=/var/lib/flat-manager/repos
FLATPAK_BUILD_PATH=/var/lib/flat-manager/builds
RPM_REPO_BASE_PATH=/var/lib/flat-manager/rpm-repos
STATIC_ROOT=/var/lib/flat-manager/staticfiles
MEDIA_ROOT=/var/lib/flat-manager/media
LOG_DIR=/var/log/flat-manager
TEMP_DIR=/var/lib/flat-manager/tmp

# ── Optional CORS (only needed if you access the API from a browser origin) ──
# CORS_ALLOWED_ORIGINS=https://example.com
