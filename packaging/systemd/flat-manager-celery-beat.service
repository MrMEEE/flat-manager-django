[Unit]
Description=Flat Manager — Celery beat scheduler
Documentation=https://github.com/YOUR_ORG/flat-manager-django
After=network.target mariadb.service redis.service valkey.service flat-manager-celery.service
Wants=flat-manager-celery.service

[Service]
Type=forking
User=flat-manager
Group=flat-manager
WorkingDirectory=/opt/flat-manager/app
EnvironmentFile=/etc/flat-manager/flat-manager.env
ExecStart=/opt/flat-manager/venv/bin/celery \
    -A config beat \
    --loglevel=info \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler \
    --logfile=/var/log/flat-manager/celery-beat.log \
    --pidfile=/run/flat-manager/celery-beat.pid \
    --detach

RuntimeDirectory=flat-manager
RuntimeDirectoryMode=0750
PIDFile=/run/flat-manager/celery-beat.pid
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/var/lib/flat-manager /var/log/flat-manager /run/flat-manager

StandardOutput=journal
StandardError=journal
SyslogIdentifier=flat-manager-celery-beat

[Install]
WantedBy=flat-manager.target multi-user.target
