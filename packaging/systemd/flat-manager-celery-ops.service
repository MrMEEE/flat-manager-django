[Unit]
Description=Flat Manager — Celery ops worker (publish, commit, promote, …)
Documentation=https://github.com/MrMEEE/flat-manager-django
After=network.target mariadb.service redis.service valkey.service flat-manager-celery.service
Wants=mariadb.service

[Service]
Type=simple
User=flat-manager
Group=flat-manager
WorkingDirectory=/opt/flat-manager/app
EnvironmentFile=/etc/flat-manager/flat-manager.env
Environment=VIRTUAL_ENV=/opt/flat-manager/venv
Environment=PATH=/opt/flat-manager/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=CELERY_OPS_WORKER_CONCURRENCY=4
ExecStartPre=/usr/bin/podman system migrate
ExecStart=/opt/flat-manager/venv/bin/celery \
    -A config worker \
    --queues=ops \
    --concurrency=${CELERY_OPS_WORKER_CONCURRENCY} \
    --hostname=ops@%h \
    --loglevel=info

RuntimeDirectory=flat-manager
RuntimeDirectoryMode=0750
LogsDirectory=flat-manager
LogsDirectoryMode=0750
StateDirectory=flat-manager
StateDirectoryMode=0750
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/var/lib/flat-manager /var/log/flat-manager /run/flat-manager

StandardOutput=journal
StandardError=journal
SyslogIdentifier=flat-manager-celery-ops

[Install]
WantedBy=flat-manager.target multi-user.target
