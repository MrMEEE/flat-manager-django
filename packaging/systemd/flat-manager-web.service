[Unit]
Description=Flat Manager — Daphne ASGI server
Documentation=https://github.com/MrMEEE/flat-manager-django
After=network.target mariadb.service redis.service valkey.service flat-manager-celery.service
Wants=mariadb.service
# Tie this unit to the Celery worker:
#   BindsTo  — if celery stops or crashes, web stops too
#   PartOf   — if celery is explicitly restarted, web is restarted too
#   After    — when restarting, wait for celery to be active first
BindsTo=flat-manager-celery.service
PartOf=flat-manager-celery.service

[Service]
Type=simple
User=flat-manager
Group=flat-manager
WorkingDirectory=/opt/flat-manager/app
EnvironmentFile=/etc/flat-manager/flat-manager.env
Environment=VIRTUAL_ENV=/opt/flat-manager/venv
Environment=PATH=/opt/flat-manager/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=/bin/chown -R flat-manager:flat-manager /var/log/flat-manager
UMask=0002
ExecStart=/opt/flat-manager/venv/bin/daphne \
    -u /run/flat-manager/daphne.sock \
    --access-log /var/log/flat-manager/access.log \
    config.asgi:application

RuntimeDirectory=flat-manager
RuntimeDirectoryMode=0755
LogsDirectory=flat-manager
LogsDirectoryMode=0750
StateDirectory=flat-manager
StateDirectoryMode=0750
Restart=always
RestartSec=5
TimeoutStopSec=30

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/var/lib/flat-manager /var/log/flat-manager /run/flat-manager

StandardOutput=journal
StandardError=journal
SyslogIdentifier=flat-manager-web

[Install]
WantedBy=flat-manager.target multi-user.target
