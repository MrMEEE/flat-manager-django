[Unit]
Description=Flat Manager — Daphne ASGI server
Documentation=https://github.com/MrMEEE/flat-manager-django
After=network.target mariadb.service redis.service valkey.service
Wants=mariadb.service

[Service]
Type=simple
User=flat-manager
Group=flat-manager
WorkingDirectory=/opt/flat-manager/app
EnvironmentFile=/etc/flat-manager/flat-manager.env
ExecStartPre=/bin/chown -R flat-manager:flat-manager /var/log/flat-manager
# UMask=0111 ensures the UNIX socket is created with mode 0666 (world r/w)
# immediately, so nginx can connect without any post-start chmod step.
UMask=0111
ExecStart=/opt/flat-manager/venv/bin/daphne \
    -u /run/flat-manager/daphne.sock \
    --access-log /var/log/flat-manager/access.log \
    config.asgi:application

RuntimeDirectory=flat-manager
RuntimeDirectoryMode=0755
LogsDirectory=flat-manager
LogsDirectoryMode=0750
StateDirectory=flat-manager
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/var/lib/flat-manager /var/log/flat-manager /run/flat-manager

StandardOutput=journal
StandardError=journal
SyslogIdentifier=flat-manager-web

[Install]
WantedBy=flat-manager.target multi-user.target
