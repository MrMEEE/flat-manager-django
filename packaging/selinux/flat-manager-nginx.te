module flat-manager-nginx 1.0;

require {
    type httpd_t;
    type unconfined_service_t;
    type var_run_t;
    class unix_stream_socket connectto;
    class sock_file write;
}

# Allow nginx (httpd_t) to connect to the Daphne UNIX socket.
# Daphne runs under a systemd service with no custom SELinux type,
# so it inherits unconfined_service_t.
allow httpd_t unconfined_service_t:unix_stream_socket connectto;

# Allow nginx to write (open) the sock_file node in /run/ (var_run_t).
allow httpd_t var_run_t:sock_file write;
